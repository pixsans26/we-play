{
  "name": "playzure-server",
  "version": "2.0.1",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "ENV_FILE=.env.local tsx watch src/index.ts",
    "dev:prod": "NODE_ENV=production ENV_FILE=.env.production tsx watch src/index.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/src/index.js",
    "start:local": "ENV_FILE=.env.local node dist/src/index.js",
    "start:prod": "NODE_ENV=production ENV_FILE=.env.production node dist/src/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:local": "ENV_FILE=.env.local drizzle-kit push",
    "db:push:prod": "ENV_FILE=.env.production drizzle-kit push"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
